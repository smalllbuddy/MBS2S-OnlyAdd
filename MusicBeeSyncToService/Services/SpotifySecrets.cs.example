// Template for your own Spotify app credentials.
// 1. Create an app at https://developer.spotify.com/dashboard
// 2. Add this exact Redirect URI to the app: http://127.0.0.1:5000/callback/
//    (the plugin listens for Spotify's reply on that address)
// 3. Copy this file to SpotifySecrets.cs in this same folder and fill in your
//    app's Client ID and Client secret.
// SpotifySecrets.cs is listed in .gitignore, so your secret never gets uploaded.
namespace MusicBeePlugin.Services
{
    public static class SpotifySecrets
    {
        public const string CLIENT_ID = "your-client-id";
        public const string CLIENT_SECRET = "your-client-secret";
        public const string REDIRECT_URI = "http://127.0.0.1:5000/callback/";
    }
}
